# ============================== CELL 3: data ==============================
def set_seed(s):
    random.seed(s); np.random.seed(s); torch.manual_seed(s)
    if torch.cuda.is_available(): torch.cuda.manual_seed_all(s)
 
def synth_ratings(U=400, I=300, seed=0):
    rng = np.random.default_rng(seed)
    pu, qi = rng.normal(size=(U, 8)), rng.normal(size=(I, 8))
    pop = rng.pareto(1.2, size=I) + 1; pop /= pop.sum()
    rows = []
    for u in range(U):
        n = rng.integers(20, 80)
        lg = pu[u] @ qi.T + 3 * np.log(pop * I); p = np.exp(lg - lg.max()); p /= p.sum()
        items = rng.choice(I, size=n, replace=False, p=p)
        ts = rng.permutation(n)
        for it, t in zip(items, ts):
            rows.append((u, it, int(rng.integers(3, 6)), int(t)))
    return pd.DataFrame(rows, columns=["user", "item", "rating", "ts"])
 
def load_ratings():
    if CFG.SYNTHETIC:
        return synth_ratings()
    zp = os.path.join(CFG.DATA_DIR, "ml-1m.zip")
    if not os.path.exists(zp):
        print("Downloading MovieLens-1M ...")
        urllib.request.urlretrieve("https://files.grouplens.org/datasets/movielens/ml-1m.zip", zp)
    with zipfile.ZipFile(zp) as z:
        z.extractall(CFG.DATA_DIR)
    return pd.read_csv(os.path.join(CFG.DATA_DIR, "ml-1m", "ratings.dat"), sep="::", engine="python",
                       names=["user", "item", "rating", "ts"])
 
class Data: pass
 
def prepare_data():
    df = load_ratings()
    print(f"raw ratings: {len(df):,}")
    df = df[df.rating >= CFG.RATING_THRESHOLD][["user", "item", "ts"]].copy()
    for _ in range(10):  # iterative k-core style filtering
        uc = df.user.value_counts(); df = df[df.user.isin(uc[uc >= CFG.MIN_USER_POS].index)]
        ic = df.item.value_counts(); df = df[df.item.isin(ic[ic >= CFG.MIN_ITEM_POS].index)]
    uid = {u: k for k, u in enumerate(sorted(df.user.unique()))}
    iid = {i: k for k, i in enumerate(sorted(df.item.unique()))}
    df["u"] = df.user.map(uid); df["i"] = df.item.map(iid)
    df = df.sort_values(["u", "ts"], kind="stable").reset_index(drop=True)
    g = df.groupby("u")["i"]
    df["n"] = g.transform("size"); df["pos"] = g.cumcount(); df["rfe"] = df.n - 1 - df.pos  # rank from end
    if CFG.SPLIT == "loo":
        is_test, is_val = df.rfe == 0, df.rfe == 1
    else:
        nte = np.maximum(1, np.round(0.1 * df.n)).astype(int)
        is_test, is_val = df.rfe < nte, (df.rfe >= nte) & (df.rfe < 2 * nte)
    is_train = ~(is_test | is_val)
    U, I = len(uid), len(iid)
 
    def mat(mask):
        m = torch.zeros(U, I, dtype=torch.bool)
        m[torch.as_tensor(df.u[mask].values), torch.as_tensor(df.i[mask].values)] = True
        return m.to(DEV)
 
    D = Data(); D.U, D.I = U, I
    D.train_mat, D.val_mat, D.test_mat = mat(is_train), mat(is_val), mat(is_test)
    tr = df[is_train]
    D.tr_u = torch.as_tensor(tr.u.values, device=DEV); D.tr_i = torch.as_tensor(tr.i.values, device=DEV)
    lens = np.bincount(tr.u.values, minlength=U); Lmax = lens.max()
    pp = np.zeros((U, Lmax), dtype=np.int64)
    pp[tr.u.values, tr.groupby("u").cumcount().values] = tr.i.values
    D.pos_pad = torch.as_tensor(pp, device=DEV); D.lens = torch.as_tensor(lens, device=DEV)
    pop = np.bincount(tr.i.values, minlength=I)
    D.pop = torch.as_tensor(pop, device=DEV).float()
    nh = int(math.ceil(CFG.HEAD_FRAC * I))
    head = np.zeros(I, dtype=bool); head[np.argsort(-pop, kind="stable")[:nh]] = True
    D.head_mask = torch.as_tensor(head, device=DEV)
    share = pop[head].sum() / pop.sum()
    print(f"users={U:,} items={I:,} train={is_train.sum():,} val={is_val.sum():,} test={is_test.sum():,} "
          f"| density={is_train.sum()/(U*I):.4f} | head items={nh} carry {share:.1%} of train interactions")
    return D
 
D = prepare_data()
 
 
# %%
# ============================== CELL 4: NCF (NeuMF) model ==============================
NL = len(CFG.MLP_HIDDEN)
 
def init_params():
    E = CFG.EMB_DIM; P = {}
    P["Qg"] = torch.randn(D.I, E) * 0.1     # item embedding, GMF branch
    P["Qm"] = torch.randn(D.I, E) * 0.1     # item embedding, MLP branch
    din = 2 * E
    for k, h in enumerate(CFG.MLP_HIDDEN):
        W = torch.empty(din, h); nn.init.xavier_uniform_(W)
        P[f"W{k}"] = W; P[f"b{k}"] = torch.zeros(h); din = h
    Wo = torch.empty(E + din, 1); nn.init.xavier_uniform_(Wo)
    P["Wo"] = Wo; P["bo"] = torch.zeros(1)
    return {k: v.to(DEV) for k, v in P.items()}
 
def score(P, ug, um, items):
    """ug, um: (N,E) user embeddings (GMF / MLP branch); items: (N,n) item ids -> scores (N,n)."""
    N, n = items.shape
    g = ug[:, None, :] * P["Qg"][items]
    h = torch.cat([um[:, None, :].expand(N, n, -1), P["Qm"][items]], dim=-1)
    for k in range(NL):
        h = torch.relu(h @ P[f"W{k}"] + P[f"b{k}"])
    z = torch.cat([g, h], dim=-1)
    return (z @ P["Wo"]).squeeze(-1) + P["bo"]
 
def make_item_w(beta):
    """Popularity-aware weight  w_i = 1 + beta * (1 - pop_i / max_j pop_j)."""
    if CFG.POP_NORM == "log":
        r = torch.log1p(D.pop) / torch.log1p(D.pop.max())
    else:
        r = D.pop / D.pop.max()
    return 1.0 + beta * (1.0 - r)
 
 
# %%
# ============================== CELL 5: evaluation (utility + fairness) ==============================
def gini(x):
    x = np.sort(np.asarray(x, dtype=np.float64)); n = len(x)
    if x.sum() == 0: return 0.0
    return float((2 * (np.arange(1, n + 1) * x).sum()) / (n * x.sum()) - (n + 1) / n)
 
@torch.no_grad()
def evaluate(P, Uemb, split="test", K=None, chunk=128, scorer=None):
    """scorer(u_idx) -> (n, I) scores can replace the NCF model (used for the Random / MostPop reference rows)."""
    K = K or CFG.TOPK; E = CFG.EMB_DIM
    if scorer is None: P = {k: v.detach() for k, v in P.items()}; Uemb = Uemb.detach()
    target = D.val_mat if split == "val" else D.test_mat
    excl = D.train_mat if split == "val" else (D.train_mat | D.val_mat)
    U, I = D.U, D.I
    items_all = torch.arange(I, device=DEV)
    tops = []
    for s in range(0, U, chunk):
        u = torch.arange(s, min(U, s + chunk), device=DEV)
        sc = scorer(u) if scorer is not None else score(P, Uemb[u, :E], Uemb[u, E:], items_all[None, :].expand(len(u), I))
        sc = sc.masked_fill(excl[u], float("-inf"))
        tops.append(sc.topk(K, dim=1).indices)
    top = torch.cat(tops)                                    # (U,K)
    hits = target.gather(1, top)                             # (U,K) bool
    nrel = target.sum(1); valid = nrel > 0
    disc = 1.0 / torch.log2(torch.arange(K, device=DEV).float() + 2)
    hr = hits.any(1).float()[valid].mean()
    rec = (hits.sum(1).float() / nrel.clamp(min=1).float())[valid].mean()
    dcg = (hits.float() * disc).sum(1)
    idcg = torch.cumsum(disc, 0)[(nrel.clamp(max=K) - 1).clamp(min=0)]
    ndcg = (dcg / idcg)[valid].mean()
    first = hits.float().argmax(1)
    mrr = torch.where(hits.any(1), 1.0 / (first.float() + 1), torch.zeros_like(first, dtype=torch.float))[valid].mean()
    # ---- fairness ----
    expo = torch.zeros(I, device=DEV).index_add_(0, top.reshape(-1), disc.repeat(U))   # position-discounted exposure
    cnt = torch.bincount(top.reshape(-1), minlength=I)
    head, tail = D.head_mask, ~D.head_mask
    Eh, Et, Eall = expo[head].sum() / head.sum(), expo[tail].sum() / tail.sum(), expo.mean()
    topmat = torch.zeros(U, I, dtype=torch.bool, device=DEV).scatter_(1, top, True)
    thit = target & topmat
    rh = thit[:, head].sum().float() / target[:, head].sum().clamp(min=1)
    rt = thit[:, tail].sum().float() / target[:, tail].sum().clamp(min=1)
    return dict(
        hr=hr.item(), recall=rec.item(), ndcg=ndcg.item(), mrr=mrr.item(),
        tail_cov=(cnt[tail] > 0).float().mean().item(),        # fraction of tail items recommended at least once
        cat_cov=(cnt > 0).float().mean().item(),
        exp_gap=((Eh - Et) / Eall).item(),                     # normalised per-item exposure gap head - tail  (lower = fairer)
        tail_share=(expo[tail].sum() / expo.sum()).item(),     # share of total exposure going to tail items
        gini=gini(expo.cpu().numpy()),                         # Gini of item exposure (lower = fairer)
        ht_gap=(rh - rt).item(),                               # head-tail recall gap
        arp=D.pop[top].mean().item(),                          # average popularity of recommended items
    )
 
 
# %%
# ============================== CELL 6: privacy layer + accounting ==============================
def privatize(flat, m, C, cohort):
    """flat: (n, d) raw per-client updates. Clip (ALWAYS by L2 norm, matching slide 12's single clip formula
    g_bar_u = g_u * min(1, C/||g_u||_2), used before either noise mechanism), then add noise, per client."""
    if m.clip:
        nrm = flat.norm(p=2, dim=1)
        flat = flat * (C / (nrm + 1e-12)).clamp(max=1.0)[:, None]
    if m.noise:
        if m.mech == "gaussian":
            std = m.sigma * C
            if m.mode == "distributed":
                std = std / math.sqrt(cohort)           # sum over the cohort has std sigma*C
            flat = flat + torch.randn_like(flat) * std
        else:  # Laplace: scale C/eps_lap, matching slide 12's literal formula g_bar_u + Lap(0, C/eps) exactly.
            # NOTE: pairing an L2-clipped update with a Laplace mechanism calibrated to L1 sensitivity C is the
            # slide's own simplification (a rigorous eps-DP guarantee for Laplace needs an L1 sensitivity bound,
            # which an L2 clip alone does not give); kept as-is deliberately to match the proposal's formula, and
            # the epsilon reported for this mechanism should be read as the proposal's own approximate budget, not
            # a fully rigorous one -- see the docs' limitations section.
            b = C / m.eps_lap
            lap = torch.distributions.Laplace(torch.zeros((), device=flat.device), torch.tensor(b, device=flat.device))
            flat = flat + lap.sample(flat.shape)
    return flat
 
def rdp_subsampled_gauss(q, sigma, alpha):           # Mironov et al. 2019, integer orders
    k = np.arange(alpha + 1)
    lt = (gammaln(alpha + 1) - gammaln(k + 1) - gammaln(alpha - k + 1)
          + (alpha - k) * np.log1p(-q) + k * np.log(q) + (k * k - k) / (2 * sigma ** 2))
    return logsumexp(lt) / (alpha - 1)
 
def eps_central_subsampled(sigma, q, T, delta):      # user-level (add/remove) DP-FedAvg with secure aggregation
    return float(min(T * rdp_subsampled_gauss(q, sigma, a) + math.log(1 / delta) / (a - 1) for a in range(2, 257)))
 
def eps_local_gauss(sigma, K, delta, sens=2.0):      # per-client LDP, K participations, L2 sensitivity = 2C (replace-one)
    a = np.concatenate([np.linspace(1.01, 10, 300), np.arange(11, 2049)])
    return float((K * a * sens ** 2 / (2 * sigma ** 2) + np.log(1 / delta) / (a - 1)).min())
 
def compute_epsilon(m, part_counts, q, T):
    if not (m.clip and m.noise): return float("inf")
    if m.mech == "laplace":
        return float(part_counts.max().item() * m.eps_lap)
    if m.mode == "distributed":
        return eps_central_subsampled(m.sigma, q, T, CFG.DELTA)
    return eps_local_gauss(m.sigma, int(part_counts.max().item()), CFG.DELTA)
 
 
# %%
# ============================== CELL 7: federated + centralized training ==============================
@dataclass
class Method:
    name: str
    kind: str = "fed"            # 'central' | 'fed'
    clip: bool = False
    noise: bool = False
    sigma: float = 0.0
    mech: str = "gaussian"
    eps_lap: float = 1.0
    beta: float = 0.0
    adaptive_beta: bool = False   # True -> server-side monitor (slide 15, step 2.5) adjusts beta during training;
                                  # False -> beta stays fixed at the given value for the whole run (used for the beta-sweep ablation)
    mode: str = None             # None -> CFG.NOISE_MODE ; 'local' | 'distributed'
 
    def __post_init__(self):
        if self.mode is None: self.mode = CFG.NOISE_MODE
 
REF = dict(val_gap=None, C=CFG.CLIP_NORM, mostpop_test=None)   # filled by the tuning cell / the Vanilla FedRec run
 
def clip_for(m):
    """Public clipping bound C, calibrated once from the non-private Vanilla FedRec run (median per-client gradient
    norm). One global C for every method, matching the slides (||g_u|| <= C) -- there is no separate fairness-only
    clipping bound because there is no longer a large-gradient fairness regulariser: popularity reweighting only
    rescales the existing BPR gradient by w_i in [1, 1+beta], it does not add a new, larger gradient term."""
    return REF["C"]
 
def make_grad_fn():
    """Per-client gradient of the local loss wrt (shared params, own user embedding), vectorised with vmap.
    Loss = weighted BPR only (slide 13: L_u = sum_i w_i * L_BPR(u,i,j)), no extra fairness term -- the only
    fairness mechanism is the popularity weight w_i baked into wpos below, plus the server-side beta monitor
    (train_federated), matching the slides exactly."""
    E = CFG.EMB_DIM
 
    def client_loss(P, u, pos, neg, wpos, nmask, trow):
        ug, um = u[:E], u[E:]
        B, K = neg.shape
        items = torch.cat([pos[:, None], neg], 1).reshape(1, -1)
        s = score(P, ug[None], um[None], items)[0].reshape(B, 1 + K)
        diff = s[:, :1] - s[:, 1:]
        loss = (-F.logsigmoid(diff) * nmask * wpos[:, None]).sum() / (B * K)     # weighted BPR
        return loss, loss.detach()
 
    return vmap(grad(client_loss, argnums=(0, 1), has_aux=True), in_dims=(None, 0, 0, 0, 0, 0, 0))
 
def make_batch(ch, item_w):
    n, B, K = len(ch), CFG.LOCAL_POS_BATCH, CFG.NUM_NEG
    L = D.lens[ch]
    r = torch.minimum((torch.rand(n, B, device=DEV) * L[:, None]).long(), (L - 1)[:, None])
    pos = D.pos_pad[ch[:, None], r]
    neg = torch.randint(0, D.I, (n, B, K), device=DEV)
    nmask = (~D.train_mat[ch[:, None, None], neg]).float()     # ignore sampled "negatives" that are true positives
    return pos, neg, item_w[pos], nmask, D.train_mat[ch]
 
def lr_at(t):
    if not CFG.LR_DECAY: return CFG.LR_SERVER
    return CFG.LR_SERVER * (0.1 + 0.9 * 0.5 * (1 + math.cos(math.pi * t / CFG.ROUNDS)))
 
def user_adam(Uemb, mU, vU, tU, ids, g, lr, b1=0.9, b2=0.999, eps=1e-8):
    tU[ids] += 1; t = tU[ids][:, None]
    mU[ids] = b1 * mU[ids] + (1 - b1) * g
    vU[ids] = b2 * vU[ids] + (1 - b2) * g * g
    Uemb[ids] -= lr * (mU[ids] / (1 - b1 ** t)) / ((vU[ids] / (1 - b2 ** t)).sqrt() + eps)
 
def train_federated(m, seed, C_clip):
    set_seed(seed)
    U, I, E = D.U, D.I, CFG.EMB_DIM
    params = {k: nn.Parameter(v) for k, v in init_params().items()}
    keys = list(params); shapes = [params[k].shape for k in keys]; sizes = [params[k].numel() for k in keys]
    opt = torch.optim.Adam(params.values(), lr=CFG.LR_SERVER)
    Uemb = torch.randn(U, 2 * E, device=DEV) * 0.1          # PRIVATE: stays on the clients, never uploaded
    mU, vU, tU = torch.zeros_like(Uemb), torch.zeros_like(Uemb), torch.zeros(U, device=DEV)
    part = torch.zeros(U, device=DEV)
    q = CFG.CLIENTS_PER_ROUND / U; cohort = CFG.CLIENTS_PER_ROUND
    beta = m.beta; item_w = make_item_w(beta)
    grad_fn = make_grad_fn()
    if m.clip: assert C_clip is not None, "clipping norm not calibrated yet (run Vanilla FedRec first or set CFG.CLIP_NORM)"
    hist, norm_log, best = [], [], dict(ndcg=-1, P=None, U=None)
    max_val, sel_start = -1.0, CFG.SELECT_START_FRAC * CFG.ROUNDS
    n_clipped, n_total = 0, 0
    t0 = time.time()
    for t in range(1, CFG.ROUNDS + 1):
        ids = (torch.rand(U, device=DEV) < q).nonzero().squeeze(1)
        if ids.numel() == 0: continue
        part[ids] += 1
        for g_ in opt.param_groups: g_["lr"] = lr_at(t)
        Pd = {k: v.detach() for k, v in params.items()}
        acc = torch.zeros(sum(sizes), device=DEV)
        for ci, ch in enumerate(ids.split(CFG.CLIENT_CHUNK)):
            (gP, gu), _ = grad_fn(Pd, Uemb[ch], *make_batch(ch, item_w))
            flat = torch.cat([gP[k].reshape(len(ch), -1) for k in keys], 1)
            nrm = flat.norm(dim=1)
            if t % 10 == 0 and ci == 0: norm_log.append(nrm.median().item())
            if m.clip: n_clipped += (nrm > C_clip).sum().item(); n_total += len(ch)
            if m.clip or m.noise: flat = privatize(flat, m, C_clip, cohort)
            w = torch.ones(len(ch), device=DEV) if CFG.AGG_WEIGHT == "uniform" else D.lens[ch].float() / D.lens.float().mean()
            acc += (w[:, None] * flat).sum(0)
            user_adam(Uemb, mU, vU, tU, ch, gu, CFG.LR_USER)          # local update of the private user vector
        agg = acc / cohort
        off = 0
        for k, sz, shp in zip(keys, sizes, shapes):
            params[k].grad = agg[off:off + sz].view(shp).clone(); off += sz
        opt.step()
        if t % CFG.EVAL_EVERY == 0 or t == CFG.ROUNDS:
            res = evaluate(params, Uemb, "val")
            hist.append(dict(round=t, val_ndcg=res["ndcg"], val_gap=res["exp_gap"], beta=beta))
            max_val = max(max_val, res["ndcg"])
            if t >= sel_start and res["ndcg"] > best["ndcg"]:
                best = dict(ndcg=res["ndcg"], P={k: v.detach().clone() for k, v in params.items()}, U=Uemb.clone())
            if m.adaptive_beta:                                          # server-side fairness monitor
                tgt = CFG.GAP_TARGET_RATIO * (REF["val_gap"] if REF["val_gap"] is not None else 1.0)
                if res["ndcg"] < (1 - CFG.NDCG_TOL) * max_val: beta = max(0.0, beta - CFG.BETA_STEP)
                elif res["exp_gap"] > tgt:                            beta = min(CFG.BETA_MAX, beta + CFG.BETA_STEP)
                else:                                                 beta = max(0.0, beta - CFG.BETA_STEP)
                item_w = make_item_w(beta)
            if CFG.VERBOSE: print(f"  [{m.name}] round {t:5d}/{CFG.ROUNDS} val NDCG@{CFG.TOPK}={res['ndcg']:.4f} "
                  f"val exp-gap={res['exp_gap']:.3f} beta={beta:.2f} ({time.time()-t0:.0f}s)")
    return best["P"], best["U"], hist, part, norm_log, q, (n_clipped / max(1, n_total))
 
def train_centralized(m, seed):
    set_seed(seed)
    U, I, E, K = D.U, D.I, CFG.EMB_DIM, CFG.NUM_NEG
    params = {k: nn.Parameter(v) for k, v in init_params().items()}
    Uemb = nn.Parameter(torch.randn(U, 2 * E, device=DEV) * 0.1)
    opt = torch.optim.Adam(list(params.values()) + [Uemb], lr=CFG.LR_SERVER)
    Bsz = CFG.CLIENTS_PER_ROUND * CFG.LOCAL_POS_BATCH; Ntr = D.tr_u.numel()
    hist, best, t0 = [], dict(ndcg=-1, P=None, U=None), time.time()
    sel_start = CFG.SELECT_START_FRAC * CFG.ROUNDS
    for t in range(1, CFG.ROUNDS + 1):
        for g_ in opt.param_groups: g_["lr"] = lr_at(t)
        idx = torch.randint(0, Ntr, (Bsz,), device=DEV)
        u, pos = D.tr_u[idx], D.tr_i[idx]
        neg = torch.randint(0, I, (Bsz, K), device=DEV)
        nmask = (~D.train_mat[u[:, None], neg]).float()
        s = score(params, Uemb[u, :E], Uemb[u, E:], torch.cat([pos[:, None], neg], 1))
        loss = (-F.logsigmoid(s[:, :1] - s[:, 1:]) * nmask).sum() / (Bsz * K)
        opt.zero_grad(); loss.backward(); opt.step()
        if t % CFG.EVAL_EVERY == 0 or t == CFG.ROUNDS:
            res = evaluate(params, Uemb, "val")
            hist.append(dict(round=t, val_ndcg=res["ndcg"], val_gap=res["exp_gap"], beta=0.0))
            if t >= sel_start and res["ndcg"] > best["ndcg"]:
                best = dict(ndcg=res["ndcg"], P={k: v.detach().clone() for k, v in params.items()}, U=Uemb.detach().clone())
            if CFG.VERBOSE: print(f"  [{m.name}] step {t:5d}/{CFG.ROUNDS} loss={loss.item():.4f} val NDCG@{CFG.TOPK}={res['ndcg']:.4f} ({time.time()-t0:.0f}s)")
    return best["P"], best["U"], hist
 
 
# %%
# ============================== CELL 8: privacy attack (what does the server learn from ONE update?) ==============================
def attack_eval(P, Uemb, m, C_clip, n_clients=None, seed=123):
    """Item-inference attack by an honest-but-curious server. It sees one client's uploaded update (after the
    method's privacy layer) and ranks items by the L2 norm of their item-embedding gradient rows. Ground truth:
    the positive items the client used in that round. Reports mean per-client AUC (0.5 = chance) and precision@|pos|."""
    n_clients = n_clients or CFG.ATTACK_CLIENTS
    E, I = CFG.EMB_DIM, D.I
    g = torch.Generator(device="cpu").manual_seed(seed)
    ids_all = torch.randperm(D.U, generator=g)[:n_clients].to(DEV)
    grad_fn = make_grad_fn(); item_w = make_item_w(m.beta)
    Pd = {k: v.detach() for k, v in P.items()}; keys = list(Pd)
    aucs, precs = [], []
    for ch in ids_all.split(CFG.CLIENT_CHUNK):
        pos, neg, wpos, nmask, trow = make_batch(ch, item_w)
        (gP, _), _ = grad_fn(Pd, Uemb[ch], pos, neg, wpos, nmask, trow)
        flat = torch.cat([gP[k].reshape(len(ch), -1) for k in keys], 1)
        if m.clip or m.noise: flat = privatize(flat, m, C_clip, CFG.CLIENTS_PER_ROUND)
        rg, rm = flat[:, :I * E].reshape(len(ch), I, E), flat[:, I * E:2 * I * E].reshape(len(ch), I, E)
        sc = (rg.pow(2).sum(-1) + rm.pow(2).sum(-1)).sqrt()
        lab = torch.zeros(len(ch), I, device=DEV).scatter_(1, pos, 1.0)
        sc_np, lab_np = sc.cpu().numpy(), lab.cpu().numpy()
        for r in range(len(ch)):
            aucs.append(roc_auc_score(lab_np[r], sc_np[r]))
            npos = int(lab_np[r].sum()); top = np.argsort(-sc_np[r])[:npos]
            precs.append(lab_np[r][top].mean())
    return float(np.mean(aucs)), float(np.mean(precs))
 
 
# %%
# ============================== CELL 8b: tuning on the VALIDATION split (never touches the test split) ==============================
# 1) learning rates of the NON-private Vanilla FedRec  2) clipping norm C (one global bound, matching the slides)
# 3) largest noise sigma that keeps >= TUNE_KEEP of Vanilla's validation NDCG (same number of rounds for both) and
# stays clearly above MostPop  4) (beta, pop_norm) starting point for the fixed-beta, non-private Fair-FedRec:
# smallest |exposure gap| subject to keeping >= TUNE_KEEP of Vanilla's validation NDCG. Results overwrite CFG.* / REF
# used by the main experiments; the chosen beta is then refined further by the server-side monitor during the real run.
def val_run(m, rounds, attack=False):
    old_r, old_v = CFG.ROUNDS, CFG.VERBOSE
    CFG.ROUNDS, CFG.VERBOSE = rounds, False
    try:
        Cm = clip_for(m)
        P, Ue, hist, part, nl, q, cf = train_federated(m, 999, Cm)
        res = evaluate(P, Ue, "val"); res["clip_frac"] = cf
        if attack: res["attack_auc"] = attack_eval(P, Ue, m, Cm, n_clients=min(150, CFG.ATTACK_CLIENTS))[0]
    finally:
        CFG.ROUNDS, CFG.VERBOSE = old_r, old_v
    return res, nl
 
def mostpop_scorer(u):
    return D.pop[None, :].expand(len(u), D.I) + 1e-6 * torch.rand(len(u), D.I, device=DEV)
 
if CFG.RUN_TUNING:
    t_start = time.time(); tune_rows = []
    set_seed(0)
    mp_val = evaluate(None, None, "val", scorer=mostpop_scorer)["ndcg"]
    print(f"[tuning] MostPop val NDCG = {mp_val:.4f}")
    # ---- 1) learning rates ----
    best = None
    for lrs in CFG.TUNE_LR_SERVER:
        for lru in CFG.TUNE_LR_USER:
            CFG.LR_SERVER, CFG.LR_USER = lrs, lru
            res, nl = val_run(Method("tune-vanilla"), CFG.TUNE_ROUNDS)
            tune_rows.append(dict(stage="lr", lr_server=lrs, lr_user=lru, val_ndcg=res["ndcg"], val_gap=res["exp_gap"]))
            print(f"[tuning] LR server={lrs:g} user={lru:g} -> val NDCG={res['ndcg']:.4f} ({time.time()-t_start:.0f}s)")
            if best is None or res["ndcg"] > best[0]: best = (res["ndcg"], lrs, lru, nl, res["exp_gap"])
    v_ndcg, CFG.LR_SERVER, CFG.LR_USER, nl, v_gap = best
    if CFG.LR_SERVER == max(CFG.TUNE_LR_SERVER) and len(CFG.TUNE_LR_SERVER) > 1:
        print("[tuning] NOTE: best LR_SERVER is at the top edge of the grid -> extend TUNE_LR_SERVER upwards.")
    if REF["C"] is None: REF["C"] = float(np.mean(nl[len(nl) // 10:]))
    REF["val_gap"] = v_gap
    print(f"[tuning] chosen LR_SERVER={CFG.LR_SERVER:g} LR_USER={CFG.LR_USER:g} | Vanilla val NDCG={v_ndcg:.4f} | C={REF['C']:.4f}")
    if v_ndcg < 1.3 * mp_val:
        print("[tuning] WARNING: Vanilla is not clearly above MostPop -> train longer (CFG.ROUNDS / TUNE_ROUNDS) or widen the LR grids "
              "before trusting ANY privacy/fairness comparison.")
    # ---- 2) sigma (privacy) : compare against Vanilla trained for the SAME number of rounds ----
    r_dp = CFG.TUNE_ROUNDS_DP or CFG.ROUNDS
    if r_dp != CFG.TUNE_ROUNDS:
        res, _ = val_run(Method("tune-vanilla-ref"), r_dp); v_ref = res["ndcg"]
        print(f"[tuning] Vanilla val NDCG at {r_dp} rounds (reference for the sigma stage) = {v_ref:.4f}")
    else:
        v_ref = v_ndcg
    ok = []
    for sg in CFG.TUNE_SIGMA_GRID:
        res, _ = val_run(Method("tune-dp", clip=True, noise=True, sigma=sg), r_dp, attack=True)
        tune_rows.append(dict(stage="sigma", sigma=sg, val_ndcg=res["ndcg"], val_gap=res["exp_gap"], attack_auc=res["attack_auc"],
                              clip_frac=res["clip_frac"]))
        good = res["ndcg"] >= max(CFG.TUNE_KEEP * v_ref, 1.1 * mp_val)
        print(f"[tuning] sigma={sg:g} -> val NDCG={res['ndcg']:.4f} ({res['ndcg']/v_ref:.0%} of Vanilla) "
              f"attack AUC={res['attack_auc']:.3f} clipped={res['clip_frac']:.0%} {'OK' if good else 'too noisy'}")
        if good: ok.append(sg)
    CFG.SIGMA_MAIN = max(ok) if ok else min(CFG.TUNE_SIGMA_GRID)
    if not ok: print("[tuning] WARNING: no sigma keeps the utility target; using the smallest one. Consider a larger CLIENTS_PER_ROUND "
                     "or NOISE_MODE='distributed'.")
    CFG.SIGMA_GRID = sorted({round(CFG.SIGMA_MAIN * f, 5) for f in CFG.SIGMA_SWEEP_FACTORS})
    print("[tuning] NOTE: sigma was chosen for utility. If its attack AUC above is still far from 0.5, the privacy gain is weak: "
          "report that honestly, or accept a larger utility loss (lower TUNE_KEEP) / use a larger cohort.")
    # ---- 3) fairness knob: starting beta + pop_norm (fixed beta, monitor OFF, non-private) ----
    # This picks the best STARTING point for beta; the server-side monitor (slide 15 step 2.5, adaptive_beta=True)
    # then adjusts it during the real training run, so the final beta trajectory is not fixed even though this
    # search stage uses a fixed beta for a clean, uncounfounded comparison between candidates.
    default_norm, cands = CFG.POP_NORM, []
    for b, pn in CFG.TUNE_FAIR_GRID:
        CFG.POP_NORM = pn
        res, nl_f = val_run(Method("tune-fair", beta=b, adaptive_beta=False), CFG.TUNE_ROUNDS)
        tune_rows.append(dict(stage="fair", beta=b, pop_norm=pn, val_ndcg=res["ndcg"], val_gap=res["exp_gap"], val_tail_cov=res["tail_cov"]))
        print(f"[tuning] beta={b:g} pop_norm={pn} -> val NDCG={res['ndcg']:.4f} ({res['ndcg']/v_ndcg:.0%}) "
              f"exp-gap={res['exp_gap']:.3f} (Vanilla {v_gap:.3f}) tail-cov={res['tail_cov']:.3f}")
        cands.append((b, pn, res["ndcg"], abs(res["exp_gap"])))
    CFG.POP_NORM = default_norm
    feas = [c for c in cands if c[2] >= CFG.TUNE_KEEP * v_ndcg]
    pick = min(feas, key=lambda c: c[3]) if feas else max(cands, key=lambda c: c[2])
    if not feas: print(f"[tuning] WARNING: no candidate keeps {CFG.TUNE_KEEP:.0%} of Vanilla's NDCG; picked the highest-NDCG one "
                       f"({pick[2]/v_ndcg:.0%}). The paper's 'acceptable accuracy loss' claim is NOT met by this grid.")
    CFG.BETA_MAIN, CFG.POP_NORM = pick[0], pick[1]
    pd.DataFrame(tune_rows).to_csv(f"{CFG.OUT_DIR}/tuning_log.csv", index=False)
    print(f"[tuning] DONE in {(time.time()-t_start)/60:.1f} min -> SIGMA_MAIN={CFG.SIGMA_MAIN:g}  BETA_MAIN(start)={CFG.BETA_MAIN:g}  "
          f"POP_NORM={CFG.POP_NORM}  LR_SERVER={CFG.LR_SERVER:g}  LR_USER={CFG.LR_USER:g}  "
          f"(the server-side monitor will adjust beta from this starting point during the real Fair-FedRec / FairPriv-FedRec runs)")
 
 
# %%
# ============================== CELL 9: experiment runner ==============================
def run_one(m, seed, group="main"):
    t0 = time.time()
    print(f"\n=== {m.name} | seed {seed} | group={group} ===")
    if m.kind == "central":
        P, Ue, hist = train_centralized(m, seed)
        eps, att_auc, att_prec, extra = float("nan"), float("nan"), float("nan"), {}
    else:
        Cm = clip_for(m)
        P, Ue, hist, part, norm_log, q, clip_frac = train_federated(m, seed, Cm)
        eps = compute_epsilon(m, part, q, CFG.ROUNDS)
        att_auc, att_prec = attack_eval(P, Ue, m, Cm) if m.mode == "local" or not m.noise else (float("nan"), float("nan"))
        extra = dict(clip_frac=clip_frac, median_grad_norm=float(np.mean(norm_log[len(norm_log)//10:])) if norm_log else float("nan"),
                     max_participations=int(part.max().item()))
        if m.name == "Vanilla FedRec":                       # calibrate the public clipping bound + reference gap
            if REF["C"] is None:
                REF["C"] = extra["median_grad_norm"]; print(f"  calibrated clipping norm C = {REF['C']:.5f}")
            REF["val_gap"] = evaluate(P, Ue, "val")["exp_gap"]
    row = dict(method=m.name, seed=seed, group=group, mode=m.mode, C=(Cm if m.kind != "central" else float("nan")), sigma=m.sigma, beta=m.beta,
               adaptive_beta=m.adaptive_beta, eps=eps, attack_auc=att_auc, attack_prec=att_prec, time_s=time.time() - t0)
    row.update(evaluate(P, Ue, "test")); row.update(extra)
    row["near_mostpop"] = bool(REF["mostpop_test"] is not None and row["ndcg"] < 1.15 * REF["mostpop_test"])
    if row["near_mostpop"] and m.kind != "central":
        print("  !! NDCG is within 15% of the MostPop recommender: this model is (nearly) popularity-only, so its fairness numbers are not meaningful.")
    print(f"  TEST NDCG@{CFG.TOPK}={row['ndcg']:.4f} HR={row['hr']:.4f} tail-cov={row['tail_cov']:.3f} "
          f"exp-gap={row['exp_gap']:.3f} gini={row['gini']:.3f} eps={eps:.3g} attackAUC={att_auc:.3f} "
          f"clipped={row.get('clip_frac', float('nan')):.0%}")
    return row, hist
 
S = CFG.SIGMA_MAIN
MAIN = [
    Method("Centralized NCF", kind="central"),
    Method("Vanilla FedRec"),
    Method("DP-FedRec", clip=True, noise=True, sigma=S),
    # Fair-FedRec / FairPriv-FedRec: ONLY the slide-13 popularity-reweighted BPR loss (no extra client-side fairness
    # loss term), plus the slide-15-step-2.5 server-side monitor that adjusts beta from the tuned starting value
    # during training (adaptive_beta=True) -- this is the "adjust beta / fairness weight" feedback loop in the
    # slide-10 diagram, not a client-side optimization target.
    Method("Fair-FedRec", beta=CFG.BETA_MAIN, adaptive_beta=True),
    Method("FairPriv-FedRec", clip=True, noise=True, sigma=S, beta=CFG.BETA_MAIN, adaptive_beta=True),
    # Local per-client noise on ~O(item_catalog x emb_dim) parameters can dilute the popularity-reweighting signal in
    # the same way it dilutes the raw BPR signal. The secure-aggregation / distributed-noise variant needs far less
    # noise per dimension for the same formal epsilon, so it is reported too.
    Method("FairPriv-FedRec (secure agg)", clip=True, noise=True, sigma=CFG.DIST_SIGMA_MAIN, mode="distributed",
           beta=CFG.BETA_MAIN, adaptive_beta=True),
]
 
rows, hists = [], {}
# Reference recommenders. IMPORTANT for interpreting fairness: a near-random recommender is "fair" by construction, so a
# fairness gain is only meaningful when accuracy (NDCG) stays close to the non-private / non-fair models.
set_seed(0)
for nm, sc_fn in [("Random (reference)", lambda u: torch.rand(len(u), D.I, device=DEV)),
                  ("MostPop (reference)", lambda u: D.pop[None, :].expand(len(u), D.I) + 1e-6 * torch.rand(len(u), D.I, device=DEV))]:
    r = dict(method=nm, seed=CFG.SEEDS[0], group="reference", sigma=0.0, beta=0.0, adaptive_beta=False, eps=float("nan"),
             attack_auc=float("nan"), attack_prec=float("nan")); r.update(evaluate(None, None, "test", scorer=sc_fn))
    rows.append(r); print(f"{nm}: NDCG={r['ndcg']:.4f} tail-cov={r['tail_cov']:.3f} exp-gap={r['exp_gap']:.3f} gini={r['gini']:.3f}")
REF["mostpop_test"] = [r for r in rows if r["method"] == "MostPop (reference)"][0]["ndcg"]
for seed in CFG.SEEDS:
    for m in MAIN:
        r, h = run_one(m, seed, "main"); rows.append(r); hists[(m.name, seed)] = h
        pd.DataFrame(rows).to_csv(f"{CFG.OUT_DIR}/raw_main.csv", index=False)   # saved incrementally: a disconnect mid-run loses at most one method
print("\nClipping norm C =", REF["C"])
 
 
# %%
# ============================== CELL 10: ablations / sweeps (seed = first seed) ==============================
if CFG.RUN_ABLATIONS:
    s0 = CFG.SEEDS[0]; B = CFG.BETA_MAIN
    plan = []
    # component ablation
    plan += [("component", Method("FairPriv w/o clipping (noise only)", noise=True, sigma=S, beta=B, adaptive_beta=True)),
             ("component", Method("FairPriv w/o noise (clip only)", clip=True, beta=B, adaptive_beta=True)),
             ("component", Method("FairPriv w/ fixed beta (no fairness monitor)", clip=True, noise=True, sigma=S, beta=B, adaptive_beta=False)),
             ("component", Method("FairPriv (Laplace, eps=%g/round)" % CFG.EPS_LAPLACE, clip=True, noise=True, mech="laplace",
                                  eps_lap=CFG.EPS_LAPLACE, beta=B, adaptive_beta=True))]
    # privacy-utility sweep (noise multiplier) for privacy-only and privacy+fairness
    for sg in CFG.SIGMA_GRID:
        plan.append(("sigma_sweep", Method("DP-FedRec", clip=True, noise=True, sigma=sg)))
        plan.append(("sigma_sweep", Method("FairPriv-FedRec", clip=True, noise=True, sigma=sg, beta=B, adaptive_beta=True)))
    # secure-aggregation / central-DP style noise: meaningful epsilon (attack AUC not reported: server only sees the sum)
    for sg in CFG.DIST_SIGMA_GRID:
        plan.append(("dist_sweep", Method("DP-FedRec (dist. noise)", clip=True, noise=True, sigma=sg, mode="distributed")))
        plan.append(("dist_sweep", Method("FairPriv-FedRec (dist. noise)", clip=True, noise=True, sigma=sg, beta=B, adaptive_beta=True, mode="distributed")))
    # fixed-beta sweep (monitor OFF, so each point is a genuinely different, constant beta -- shows the pure effect of
    # the slide-13 formula's beta parameter on its own, matching how the slides define it as a static weight)
    for b in CFG.BETA_GRID:
        plan.append(("beta_sweep", Method("FairPriv-FedRec", clip=True, noise=True, sigma=S, beta=b, adaptive_beta=False)))
    abl_rows = []
    for grp, m in plan:
        r, h = run_one(m, s0, grp); abl_rows.append(r)
        pd.DataFrame(abl_rows).to_csv(f"{CFG.OUT_DIR}/raw_ablations.csv", index=False)   # saved incrementally
    print("ablations done")
 
 
# %%
# ============================== CELL 11: tables (CSV + LaTeX) ==============================
df = pd.DataFrame(rows)
dfa = pd.DataFrame(abl_rows) if CFG.RUN_ABLATIONS else pd.DataFrame()
order = [m.name for m in MAIN]
order_all = order + ["Random (reference)", "MostPop (reference)"]
 
def ms(d, cols, order_):
    out = []
    for name in order_:
        x = d[d.method == name]
        row = {"Method": name}
        for c, lab in cols.items():
            v = x[c].dropna()
            row[lab] = "-" if len(v) == 0 else (f"{v.mean():.4f} ± {v.std(ddof=0):.4f}" if len(v) > 1 else f"{v.mean():.4f}")
        out.append(row)
    return pd.DataFrame(out)
 
t1 = ms(df, {"hr": "HR@10", "recall": "Recall@10", "ndcg": "NDCG@10", "mrr": "MRR@10"}, order_all)
t2 = ms(df, {"tail_cov": "Tail cov.↑", "cat_cov": "Catalog cov.↑", "exp_gap": "Exposure gap↓",
             "tail_share": "Tail exp. share↑", "gini": "Gini↓", "ht_gap": "Head-tail recall gap↓", "arp": "Avg. rec. pop."}, order_all)
t2.insert(1, "NDCG@10 (read fairness together with this)", ms(df, {"ndcg": "x"}, order_all)["x"].values)
t3 = ms(df, {"ndcg": "NDCG@10", "attack_auc": "Attack AUC↓ (0.5=chance)", "attack_prec": "Attack prec.↓"}, order)
eps_col = df.groupby("method").eps.first().reindex(order)
t3.insert(1, "sigma", [df[df.method == n].sigma.iloc[0] for n in order])
t3.insert(2, "epsilon (delta=%g)" % CFG.DELTA, [("-" if np.isnan(e) else ("inf" if np.isinf(e) else f"{e:.3g}")) for e in eps_col])
 
for name, t in [("table1_utility", t1), ("table2_fairness", t2), ("table3_privacy", t3)]:
    print(f"\n{name}\n", t.to_string(index=False))
    t.to_csv(f"{CFG.OUT_DIR}/{name}.csv", index=False)
    try: t.to_latex(f"{CFG.OUT_DIR}/{name}.tex", index=False, escape=True)
    except Exception as e: print("latex export skipped:", e)
 
if len(CFG.SEEDS) >= 3:   # paired t-test across seeds
    a = df[df.method == "FairPriv-FedRec"].sort_values("seed"); b = df[df.method == "DP-FedRec"].sort_values("seed")
    for c in ["ndcg", "exp_gap", "tail_cov", "gini"]:
        tt = stats.ttest_rel(a[c].values, b[c].values)
        print(f"paired t-test FairPriv vs DP-FedRec on {c}: t={tt.statistic:.3f}, p={tt.pvalue:.4f}")
 
if CFG.RUN_ABLATIONS:
    cols = ["method", "group", "mode", "sigma", "beta", "adaptive_beta", "eps", "clip_frac", "near_mostpop", "ndcg", "hr", "tail_cov", "exp_gap", "gini", "ht_gap", "attack_auc"]
    print("\nAblations / sweeps (seed %d)\n" % CFG.SEEDS[0]); print(dfa[cols].round(4).to_string(index=False))
    dfa[cols].round(5).to_csv(f"{CFG.OUT_DIR}/table4_ablations.csv", index=False)
 
 
