# ============================== CELL 12: figures ==============================
plt.rcParams.update({"font.size": 10, "figure.dpi": 120})
mk = {"Centralized NCF": "s", "Vanilla FedRec": "o", "DP-FedRec": "^", "Fair-FedRec": "D", "FairPriv-FedRec": "*",
      "FairPriv-FedRec (secure agg)": "P"}
 
# Fig 1: accuracy vs fairness trade-off
fig, ax = plt.subplots(1, 2, figsize=(10, 4))
for name in order:
    x = df[df.method == name]
    ax[0].scatter(x.exp_gap.mean(), x.ndcg.mean(), marker=mk[name], s=110, label=name)
    ax[1].scatter(x.tail_cov.mean(), x.ndcg.mean(), marker=mk[name], s=110, label=name)
for name, c in [("Random (reference)", "gray"), ("MostPop (reference)", "silver")]:
    x = df[df.method == name]
    ax[0].scatter(x.exp_gap.mean(), x.ndcg.mean(), marker="x", s=60, c=c, label=name)
    ax[1].scatter(x.tail_cov.mean(), x.ndcg.mean(), marker="x", s=60, c=c)
if CFG.RUN_ABLATIONS and len(dfa):
    bs = dfa[dfa.group == "beta_sweep"].sort_values("beta")
    ax[0].plot(bs.exp_gap, bs.ndcg, "k--", lw=1, label="FairPriv β-sweep")
    ax[1].plot(bs.tail_cov, bs.ndcg, "k--", lw=1)
    for _, r in bs.iterrows():
        ax[0].annotate(f"β={r.beta:g}", (r.exp_gap, r.ndcg), fontsize=7)
ax[0].set_xlabel("Exposure gap (head - tail), lower = fairer"); ax[0].set_ylabel("NDCG@10")
ax[1].set_xlabel("Tail-item coverage, higher = fairer"); ax[1].set_ylabel("NDCG@10")
ax[0].legend(fontsize=7); plt.tight_layout(); plt.savefig(f"{CFG.OUT_DIR}/fig1_accuracy_vs_fairness.png", dpi=300); plt.show()
 
# Fig 2: privacy-utility trade-off
if CFG.RUN_ABLATIONS and len(dfa):
    sw = dfa[dfa.group == "sigma_sweep"]
    fig, ax = plt.subplots(1, 3, figsize=(14, 3.8))
    for name, st in [("DP-FedRec", "-o"), ("FairPriv-FedRec", "-*")]:
        x = sw[sw.method == name].sort_values("sigma")
        ax[0].plot(x.sigma, x.ndcg, st, label=name); ax[1].plot(x.sigma, x.attack_auc, st, label=name)
        ax[2].plot(x.sigma, x.exp_gap, st, label=name)
    v = df[df.method == "Vanilla FedRec"]
    ax[0].axhline(v.ndcg.mean(), color="gray", ls=":", label="Vanilla (no privacy)")
    ax[1].axhline(v.attack_auc.mean(), color="gray", ls=":", label="Vanilla (no privacy)"); ax[1].axhline(0.5, color="r", ls="--", lw=0.8)
    for a_, yl in zip(ax, ["NDCG@10", "Item-inference attack AUC", "Exposure gap"]):
        a_.set_xlabel("noise multiplier σ"); a_.set_ylabel(yl); a_.set_xscale("log")
    ax[0].legend(fontsize=7); plt.tight_layout(); plt.savefig(f"{CFG.OUT_DIR}/fig2_privacy_utility.png", dpi=300); plt.show()
    print(sw.sort_values(["method", "sigma"])[["method", "sigma", "eps", "ndcg", "attack_auc"]].round(4).to_string(index=False))
 
